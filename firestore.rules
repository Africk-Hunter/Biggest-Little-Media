rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public site reads video placements unauthenticated; only signed-in
    // (BLM) accounts can create/edit/delete. There's a single admin role in
    // v1 — any authenticated user has full write access (see PRD 4.).
    match /videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
